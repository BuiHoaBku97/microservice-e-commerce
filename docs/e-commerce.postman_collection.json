                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.environment.set('orderVersion', data.version);",
                  "pm.test('Order is completed', () => pm.expect(data.status).to.eql('COMPLETED'));"
                ]
              }
            }
          ]
        }
