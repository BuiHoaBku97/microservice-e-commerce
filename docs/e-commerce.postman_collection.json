{
  "info": {"name": "E-commerce acceptance", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item": [
    {"name": "Login", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"{{customerEmail}}\",\"password\":\"{{customerPassword}}\"}"}, "url": "{{baseUrl}}/api/v1/auth/login"}, "event": [{"listen": "test", "script": {"exec": ["const b=pm.response.json().data; pm.environment.set('customerToken',b.accessToken); pm.environment.set('refreshToken',b.refreshToken);"]}}]},
    {"name": "Search without accents", "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/products/search?q=ao&page=0&size=20"}},
    {"name": "Checkout", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{customerToken}}"}, {"key": "Idempotency-Key", "value": "{{$guid}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"cartVersion\":{{cartVersion}},\"addressId\":{{addressId}},\"expectedItems\":[{\"skuId\":{{skuId}},\"quantity\":1,\"expectedUnitPrice\":{{unitPrice}}}]}"}, "url": "{{baseUrl}}/api/v1/orders/checkout"}, "event": [{"listen": "test", "script": {"exec": ["if(pm.response.code===201){pm.environment.set('orderId',pm.response.json().id);}"]}}]},
    {"name": "Simulate payment success", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"result\":\"SUCCESS\"}"}, "url": "{{baseUrl}}/api/v1/admin/demo/payments/{{paymentId}}/simulate"}},
    {"name": "Duplicate inventory receipt", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}, {"key": "Idempotency-Key", "value": "receipt-replay"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"quantity\":10,\"reason\":\"acceptance\"}"}, "url": "{{baseUrl}}/api/v1/admin/inventory/{{skuId}}/receipts"}},
    {"name": "Locked account negative flow", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"reason\":\"acceptance\",\"version\":{{userVersion}}}"}, "url": "{{baseUrl}}/api/v1/admin/users/{{customerId}}/lock"}}
  ]
}
