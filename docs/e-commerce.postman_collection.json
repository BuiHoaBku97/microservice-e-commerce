            "url": "{{baseUrl}}/api/v1/cart/items?version={{cartVersion}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuId\": {{skuId}},\n  \"quantity\": 1,\n  \"displayedUnitPrice\": {{unitPrice}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.environment.set('cartVersion', data.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{checkoutKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cartVersion\": {{cartVersion}},\n  \"addressId\": {{addressId}},\n  \"paymentMethod\": \"{{paymentMethod}}\",\n  \"customerNote\": \"Created from Postman\",\n  \"expectedItems\": [\n    {\n      \"skuId\": {{skuId}},\n      \"quantity\": 1,\n      \"expectedUnitPrice\": {{unitPrice}}\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.environment.set('orderId', data.id);",
                  "pm.environment.set('orderVersion', data.version);",
                  "pm.test('Order total is correct', () => pm.expect(data.totalAmount).to.eql(data.subtotal + data.shippingFee));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get payment (wait for async creation)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/payment",
            "description": "Trong Collection Runner, request tự thử lại tối đa 10 lần vì payment được tạo bất đồng bộ qua Kafka."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const retry = Number(pm.environment.get('paymentRetry') || 0);",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  pm.environment.set('paymentId', data.id);",
                  "  pm.environment.unset('paymentRetry');",
                  "  pm.test('Payment was created', () => pm.expect(data.id).to.exist);",
                  "} else if (retry < 10) {",
                  "  pm.environment.set('paymentRetry', retry + 1);",
                  "  pm.execution.setNextRequest('Get payment (wait for async creation)');",
                  "  setTimeout(() => {}, 1000);",
                  "} else {",
                  "  pm.test('Payment was created within 10 retries', () => pm.expect.fail(`Last HTTP status: ${pm.response.code}`));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Initialize payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/payment/initialize",
            "description": "Dùng cho cả MOCK_ONLINE và VNPAY. MOCK_ONLINE trả nextAction=SIMULATE; VNPAY trả nextAction=REDIRECT và paymentUrl. Với VNPAY, mở paymentUrl trên trình duyệt và không chạy request simulate."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('Payment method matches environment', () => pm.expect(data.paymentMethod).to.eql(pm.environment.get('paymentMethod')));",
                  "if (pm.environment.get('paymentMethod') === 'VNPAY') {",
                  "  pm.test('VNPay returns redirect URL', () => { pm.expect(data.nextAction).to.eql('REDIRECT'); pm.expect(data.paymentUrl).to.be.a('string').and.not.empty; });",
                  "  pm.environment.set('paymentUrl', data.paymentUrl);",
                  "} else {",
                  "  pm.test('Mock returns simulate action', () => pm.expect(data.nextAction).to.eql('SIMULATE'));",
                  "}",
                  "pm.test('Payment initialize response is visible', () => pm.expect(data.paymentId).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulate successful payment (MOCK_ONLINE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/demo/payments/{{paymentId}}/simulate",
            "description": "Chỉ chạy khi paymentMethod=MOCK_ONLINE. Nếu chọn VNPAY, bỏ qua request này, mở {{paymentUrl}} và chờ IPN/Return.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"result\": \"SUCCESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('paymentMethod') === 'VNPAY') { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get confirmed order (wait for async update)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "const retry = Number(pm.environment.get('orderRetry') || 0);",
                  "if (data.status === 'CONFIRMED') {",
                  "  pm.environment.set('orderVersion', data.version);",
                  "  pm.environment.unset('orderRetry');",
                  "  pm.test('Order is confirmed', () => pm.expect(data.status).to.eql('CONFIRMED'));",
                  "} else if (retry < 10) {",
                  "  pm.environment.set('orderRetry', retry + 1);",
                  "  pm.execution.setNextRequest('Get confirmed order (wait for async update)');",
                  "  setTimeout(() => {}, 1000);",
                  "} else {",
                  "  pm.test('Order confirmed within 10 retries', () => pm.expect.fail(`Last status: ${data.status}`));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Ship order",
