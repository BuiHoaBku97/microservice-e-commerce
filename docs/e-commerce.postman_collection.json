{
  "info": {
    "name": "E-commerce - Local acceptance flow",
    "description": "Dữ liệu test chạy tuần tự cho API trong docs/openapi.yaml. Chọn environment 'E-commerce local', chạy collection từ trên xuống bằng Collection Runner. Collection tự tạo email/code duy nhất và lưu token, ID, version từ response. Postman gọi Gateway tại localhost:8080; service ID identity-service chỉ là định danh Eureka nội bộ và không thêm vào URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runId')) {",
          "  const runId = Date.now() + '-' + Math.floor(Math.random() * 10000);",
          "  pm.environment.set('runId', runId);",
          "  if (!pm.environment.get('customerEmail')) {",
          "    pm.environment.set('customerEmail', `postman-${runId}@example.test`);",
          "  }",
          "  pm.environment.set('categoryCode', `PM-${runId}`);",
          "  pm.environment.set('categorySlug', `postman-${runId}`);",
          "  pm.environment.set('skuCode', `PM-SKU-${runId}`);",
          "  pm.environment.set('inventoryInitKey', `postman-${runId}-init`);",
          "  pm.environment.set('inventoryReceiptKey', `postman-${runId}-receipt`);",
          "  pm.environment.set('checkoutKey', `postman-${runId}-checkout`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Authentication",
      "description": "Tạo customer mới và lấy JWT cho customer lẫn admin.",
      "item": [
        {
          "name": "Register unique customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"fullName\": \"Postman Test Customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.environment.set('customerId', data.id);",
                  "pm.environment.set('userVersion', data.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.environment.set('customerToken', data.accessToken);",
                  "pm.environment.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh customer token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.environment.set('customerToken', data.accessToken);",
                  "pm.environment.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "adminEmail/adminPassword phải trùng ADMIN_EMAIL/ADMIN_PASSWORD trong file .env của Docker Compose."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.environment.set('adminToken', data.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
