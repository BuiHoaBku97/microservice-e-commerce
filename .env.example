# Generate real local values with: powershell -File scripts/generate-dev-env.ps1
CONFIG_GIT_URI=https://github.com/<owner>/ecommerce-config.git
CONFIG_GIT_USERNAME=<github-username>
CONFIG_GIT_PASSWORD=REPLACE_WITH_GITHUB_FINE_GRAINED_TOKEN
CONFIG_GIT_LABEL=main
CONFIG_GIT_CLONE_ON_START=true
CONFIG_GIT_REFRESH_RATE=0
CONFIG_GIT_FORCE_PULL=true
JWT_PRIVATE_KEY_BASE64=REPLACE_WITH_PKCS8_DER_BASE64
JWT_PUBLIC_KEY_BASE64=REPLACE_WITH_X509_DER_BASE64
ORDER_SERVICE_JWT_PRIVATE_KEY_BASE64=REPLACE_WITH_PKCS8_DER_BASE64
ORDER_SERVICE_JWT_PUBLIC_KEY_BASE64=REPLACE_WITH_X509_DER_BASE64
CATALOG_SERVICE_JWT_PRIVATE_KEY_BASE64=REPLACE_WITH_PKCS8_DER_BASE64
CATALOG_SERVICE_JWT_PUBLIC_KEY_BASE64=REPLACE_WITH_X509_DER_BASE64
PAYMENT_SERVICE_JWT_PRIVATE_KEY_BASE64=REPLACE_WITH_PKCS8_DER_BASE64
PAYMENT_SERVICE_JWT_PUBLIC_KEY_BASE64=REPLACE_WITH_X509_DER_BASE64
NOTIFICATION_SERVICE_JWT_PRIVATE_KEY_BASE64=REPLACE_WITH_PKCS8_DER_BASE64
NOTIFICATION_SERVICE_JWT_PUBLIC_KEY_BASE64=REPLACE_WITH_X509_DER_BASE64
PAYMENT_CALLBACK_SECRET=REPLACE_WITH_RANDOM_SECRET
VNPAY_ENABLED=false
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://YOUR_PUBLIC_HOST/api/v1/payments/vnpay/return
VNPAY_IPN_URL=https://YOUR_PUBLIC_HOST/api/v1/payments/vnpay/ipn
VNPAY_FRONTEND_RESULT_URL=http://localhost:3000/payment/result
VNPAY_EXPIRE_MINUTES=15

ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator

POSTGRES_PORT=5433
KAFKA_PORT=9092
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
JAEGER_UI_PORT=16686
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ORDER_SHIPPING_FEE=30000
